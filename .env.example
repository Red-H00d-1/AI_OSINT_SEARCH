# Gemini API key (Required for AI Triage - get free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# NIST NVD API key (Optional but strongly recommended to avoid rate limits: https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Gmail SMTP Settings for daily digest delivery
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
RECIPIENT_EMAIL=your_destination_email@gmail.com
